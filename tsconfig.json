{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "#/*": [
        "./src/*"
      ],
      "#static/*": [
        "./static/*"
      ],
      "#tests/*": [
        "./tests/*"
      ]
    }
  },
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "node_modules/vite-plugin-svgr/client.d.ts",
    "playwright.config.ts",
    "src",
    "tests"
  ]
}
