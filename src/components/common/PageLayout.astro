---
import RequiresJs from "@/components/common/RequiresJs.astro";
import { lastBuildTime } from "@/utils/date-utils.ts";

interface Props {
  title: string;
  description: string
  keywords?: string[]
  requiresJs?: boolean
  viewport?: string
}

const requiresJs = Astro.props.requiresJs ?? true;

const viewport = Astro.props.viewport ?? "width=device-width, initial-scale=1.0";

const pageTitle = Astro.site?.hostname
  ? `${Astro.props.title} | ${Astro.site.hostname}`
  : Astro.props.title;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="author" content="Evan O'Connor" />
    {
      Astro.props.description && (
        <meta name="description" content={Astro.props.description} />
      )
    }
    {
      Astro.props.keywords?.length && (
        <meta name="keywords" content={Astro.props.keywords.join(", ")} />
      )
    }
    <meta name="viewport" content={viewport} />
    <meta name="x-last-built-time" content={lastBuildTime} />
    <title> { pageTitle } </title>
    {
      Astro.site && (
        <link slot="head" rel="canonical" href={`${Astro.site.origin}${Astro.url.pathname}`} />
      )
    }
    {
      import.meta.env.PROD &&
      Astro.site && (
        <link rel="sitemap" href="/sitemap-index.xml" />
      )
    }
    {
      import.meta.env.PROD &&
      import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
        <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}></script>
      )
    }
    <slot name="head"></slot>
  </head>

  <body>
    <slot></slot>
  </body>

  {
    requiresJs && (
      <RequiresJs />
    )
  }
</html>
