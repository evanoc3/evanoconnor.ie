---
interface Props {
  message?: string
}

const message = Astro.props.message ?? (
  "This playground contains interactive components which require JavaScript to be enabled in order to function. " +
  "Please enable JavaScript in your browser and reload to view this playground."
);
---


<style lang="scss">
  p#no-script-msg {
    display: inline-block;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(75vw, 80ch);
    text-align: center;
  }
</style>

<noscript>
  <p id="no-script-msg">
    { message }
  </p>
</noscript>
