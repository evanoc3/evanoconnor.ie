---
import GoBack from "#/components/common/go-back.astro";

import PrinterIcon from "feather-icons/dist/icons/printer.svg";
import SunIcon from "feather-icons/dist/icons/sun.svg";
import MoonIcon from "feather-icons/dist/icons/moon.svg";
---


<style lang="scss">
  @use "breakpoints";

  .secondary-buttons-row {
    column-gap: 1rem;
    display: flex;
    flex-flow: row nowrap;
    padding: 1rem;

    > .spacer {
      flex: 1;
    }

    a {
      display: inline-block;
    }
    
    :global(a), :global(> button) {
      border-radius: 2rem;
      color: var(--button-secondary-text-colour);
      cursor: pointer;
      font-size: 1rem; 
      line-height: 1;
      padding: .75rem 1.25rem;
      transition: background-color var(--transition-duration),
                  color var(--transition-duration),
                  transform var(--transition-duration);
      
      &:hover {
        background-color: var(--button-secondary-background-hover-colour);
        color: var(--button-secondary-text-hover-colour);
        transform: scale(1.05);
      }
    }

    svg {
      height: 1rem;
      position: relative;
      top: 2px;
      width: 1rem;
    }
  }

  @media only screen and (min-width: breakpoints.$A4) {
    #secondary-buttons-row {
      padding: 1cm calc(1cm + 1rem);
    }
  }
</style>

<div class="secondary-buttons-row">
  <GoBack />

  <div class="spacer"></div>

  <button id="theme-btn" hidden>
    <SunIcon />
    <MoonIcon />
    Theme
  </button>

  <button id="print-btn" hidden data-requires-js>
    <PrinterIcon />
    Print
  </button>
</div>

<script>
  import { getBrowserTheme, getSessionStorageTheme, getUserTheme, setUserTheme, toggleTheme } from "#/utils/theme-utils";

  window.addEventListener("load", () => {
    const backButton = document.querySelector("#back-btn");
    backButton?.addEventListener("click", () => history.back());

    const printButton = document.querySelector("#print-btn");
    printButton?.addEventListener("click", () => print());

    const sessionStorageTheme = getSessionStorageTheme();
    if (sessionStorageTheme) {
      setUserTheme(sessionStorageTheme);
    }

    const themeButton = document.querySelector("#theme-btn");
    themeButton?.addEventListener("click", () => {
      const newTheme = toggleTheme(getUserTheme() ?? getBrowserTheme());
      setUserTheme(newTheme);
    });
  });

  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
    const newBrowserTheme = e.matches ? "dark" : "light";
    setUserTheme(newBrowserTheme);
  });
</script>

