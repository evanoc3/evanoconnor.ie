---
interface Props {
  title: string;
}

const { title } = Astro.props;
---


<style lang="scss">
  .section-header {
    align-items: center;
    column-gap: 0.4rem;
    display: flex;
    flex-flow: row nowrap;
    font-size: 1rem;
    margin-top: 1.2rem;

    > .line {
      background-color: var(--section-header-line-colour);
      border-radius: 999rem;
      display: block;
      flex: 1;
      height: 0.08em;
    }

    > h2 {
      color: var(--section-header-text-colour);
      flex: 0;
      font-size: 1.2em;
      font-weight: 600;
    }
  }
</style>

<section>
  <div class="section-header">
    <div class="line" />
    <h2> { title } </h2>
    <div class="line" />
  </div>

  <slot></slot>
</section>
