---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { DateTime } from "luxon";

import { getHumanReadableShortDuration } from "#/utils/date-utils.ts";


interface Props {
  icon: ImageMetadata;
  jobTitle: string;
  company: string;
  url: string;
  timespan: { start: DateTime, end?: DateTime };
  skills: { title: string, url?: string }[];
}

const { icon, jobTitle, company, url, timespan, skills } = Astro.props;

const humanReadableTimeSpanStart = timespan.start.toLocaleString({ year: "numeric", month: "short" });

const humanReadableTimeSpanTo = timespan.end
  ? timespan.end.toLocaleString({ year: "numeric", month: "short" })
  : "Present";
---


<style lang="scss">
  @use "breakpoints";

  div.experience-list-item {
    display: grid;
    grid-template-areas: "timespan timespan"
                         "icon title"
                         "icon location"
                         "icon desc"
                         "icon skills";
    grid-template-columns: 3.75rem 1fr;
    grid-template-rows: repeat(5, auto);
    margin-top: 1rem;
  }

  img {
    grid-area: icon;
    margin-right: 0.5rem;
    max-height: 3rem;
    max-width: 3rem;
  }

  h3 {
    align-self: center;
    color: var(--header-text-colour);
    grid-area: title;
    line-height: 1.4;
  }

  span.bullet {
    display: none;
  }

  a.company {
    align-self: center;
    color: var(--link-text-colour);
    font-size: 1.2rem;
    font-weight: 500;
    grid-area: location;
    justify-self: start;
    line-height: 1.4;
    text-decoration-line: underline;
    text-decoration-skip-ink: auto;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 2px;
    transition: color var(--transition-duration);

    &:hover {
      color: var(--link-text-hover-colour);
    }
  }

  div.desc {
    font-size: 0.95rem;
    grid-area: desc;
    line-height: 1.35;
  }

  span.timespan {
    align-self: center;
    color: var(--text-secondary-colour);
    font-style: italic;
    grid-area: timespan;
    justify-self: end;
  }

  :global(
    div.desc p:not(:first-of-type)
  ) {
    margin-top: 0.375rem;
  }

  a.skill {
    cursor: pointer;
    text-decoration: none;
  }

  .skill {
    background-color: var(--badge-background-colour);
    border-radius: 999rem;
    color: var(--text-primary-colour);
    font-size: 0.833rem;
    padding: .2rem .5rem;
    transition: background-color var(--transition-duration);

    &:hover {
      background-color: var(--badge-background-hover-colour);
    }
  }

  ul {
    display: flex;
    flex-flow: row wrap;
    gap: calc(1rem / 3);
    grid-area: skills;
    list-style: none;
    margin-top: 0.5rem;
  }

  @media only print {
    a.company {
      text-decoration: none;
    }
  }

  @media (min-width: breakpoints.$A4) {
    div.experience-list-item {
      grid-template-areas: "icon title  bullet location timespan"
                           "icon desc   desc   desc     desc"
                           "icon skills skills skills   skills";
      grid-template-columns: 3.75rem auto auto 1fr auto;
      grid-template-rows: repeat(3, auto);
    }

    span.bullet {
      align-self: center;
      color: var(--text-secondary-colour);
      display: block;
      font-size: 1.2rem;
      font-weight: 500;
      grid-area: bullet;
      padding: 0 0.5ch;
    }
  }
</style>

<div class="experience-list-item">
  <Image src={icon} alt="" />

  <h3>{ jobTitle }</h3>

  <span class="bullet">&bull;</span>

  <a href={url} class="company">{ company }</a>

  {
    (timespan.end === undefined)
      ? <span class="timespan" data-timespan-start={timespan.start.toISO()}>{humanReadableTimeSpanStart} &ndash; {humanReadableTimeSpanTo}</span>
      : <span class="timespan" title={getHumanReadableShortDuration(timespan.start, timespan.end)}>{humanReadableTimeSpanStart} &ndash; {humanReadableTimeSpanTo}</span>
  }

  <div class="desc">
    <slot>
    </slot>
  </div>

  <ul class="skills">
    {
      skills
        .sort((a, b) => a.title.localeCompare(b.title))
        .map(({ url, title }) => (
          url ? <li><a class="skill" href={url}>{title}</a></li> 
              : <li class="skill">{title}</li>
      ))
    }
  </ul>
</div>

<script>
  import { getHumanReadableShortDuration } from "#/utils/date-utils";
import { DateTime } from "luxon";

  const ongoingExperienceTimespanLabels = document.querySelectorAll<HTMLElement>(".timespan[data-timespan-start]");

  for(const ongoingExperienceTimespanLabel of ongoingExperienceTimespanLabels) {
    const startDate = DateTime.fromISO(ongoingExperienceTimespanLabel.dataset.timespanStart as string);
    ongoingExperienceTimespanLabel.title = getHumanReadableShortDuration(startDate, DateTime.now());
  }
</script>
