---
import ArrowLeftSvg from "feather-icons/dist/icons/arrow-left.svg";
import PrinterSvg from "feather-icons/dist/icons/printer.svg";
import SunSvg from "feather-icons/dist/icons/sun.svg";
import MoonSvg from "feather-icons/dist/icons/moon.svg";
---
<style lang="scss">
  @use "resets";
  @use "breakpoints";

  .secondary-buttons-row {
    column-gap: 1rem;
    display: flex;
    flex-flow: row nowrap;
    padding: 1rem;

    > .spacer {
      flex: 1;
    }

    > button {
      @include resets.button;
    }

    > a {
      @include resets.link;
    }
    
    > a, > button {
      border-radius: 2rem;
      color: var(--button-secondary-text-colour);
      cursor: pointer;
      font-size: 1rem; 
      line-height: 1;
      padding: .75rem 1.25rem;
      transition: background-color var(--transition-duration),
                  color var(--transition-duration),
                  transform var(--transition-duration);
      
      &:hover {
        background-color: var(--button-secondary-background-hover-colour);
        color: var(--button-secondary-text-hover-colour);
        transform: scale(1.05);
      }
    }

    button {
      &.hidden-by-default:not(.visible) {
        display: none;
      }

      &.visible {
        display: block;
      }
    }

    svg {
      height: 1rem;
      position: relative;
      top: 2px;
      width: 1rem;
    }
  }

  @media only screen and (min-width: breakpoints.$A4) {
    #secondary-buttons-row {
      padding: 1cm calc(1cm + 1rem);
    }
  }
</style>

<div class="secondary-buttons-row">
  <a href="/">
    <ArrowLeftSvg />
    Go Back
  </a>

  <div class="spacer"></div>

  <button class="theme-btn hidden-by-default">
    <SunSvg />
    <MoonSvg />
    Theme
  </button>

  <button class="print-btn hidden-by-default">
    <PrinterSvg />
    Print
  </button>
</div>

<script>
  import { getBrowserTheme, getUserTheme, toggleTheme, getSessionStorageTheme, getCurrentTheme, setUserTheme } from "@/utils/theme-utils";

  // setup print button
  const printButton = document.querySelector<HTMLButtonElement>(".print-btn");
  if (printButton) {
    printButton.addEventListener("click", () => window.print());
    printButton.classList.add("visible");
  }

  // set page theme on-load
  document.addEventListener("DOMContentLoaded", () => {
    const sessionStorageTheme = getSessionStorageTheme();
    if (sessionStorageTheme) {
      setUserTheme(sessionStorageTheme);
    }
  });

  // on browser theme change
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
    const newBrowserTheme = e.matches ? "dark" : "light";
    setUserTheme(newBrowserTheme);
  });

  // setup theme button
  const themeButton = document.querySelector<HTMLButtonElement>(".theme-btn");
  if (themeButton) {
    themeButton.addEventListener("click", () => {
      const newTheme = toggleTheme(getUserTheme() ?? getBrowserTheme());
      setUserTheme(newTheme);
    });
    // themeButton.classList.add("visible");
  }
</script>

