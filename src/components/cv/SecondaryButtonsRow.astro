---
import ArrowLeftSvg from "feather-icons/dist/icons/arrow-left.svg";
import PrinterSvg from "feather-icons/dist/icons/printer.svg";
import SunSvg from "feather-icons/dist/icons/sun.svg";
import MoonSvg from "feather-icons/dist/icons/moon.svg";
---
<style lang="scss">
  @use "resets";
  @use "breakpoints";

  .secondary-buttons-row {
    column-gap: 1rem;
    display: flex;
    flex-flow: row nowrap;
    padding: 1rem;

    > .spacer {
      flex: 1;
    }

    > button {
      @include resets.button;
    }

    a {
      @include resets.link;
      display: inline-block;
    }
    
    a, > button {
      border-radius: 2rem;
      color: var(--button-secondary-text-colour);
      cursor: pointer;
      font-size: 1rem; 
      line-height: 1;
      padding: .75rem 1.25rem;
      transition: background-color var(--transition-duration),
                  color var(--transition-duration),
                  transform var(--transition-duration);
      
      &:hover {
        background-color: var(--button-secondary-background-hover-colour);
        color: var(--button-secondary-text-hover-colour);
        transform: scale(1.05);
      }
    }

    svg {
      height: 1rem;
      position: relative;
      top: 2px;
      width: 1rem;
    }
  }

  @media only screen and (min-width: breakpoints.$A4) {
    #secondary-buttons-row {
      padding: 1cm calc(1cm + 1rem);
    }
  }
</style>

<div class="secondary-buttons-row">
  <noscript>
    <a href="/">
      <ArrowLeftSvg />
      Home
    </a>
  </noscript>

  <button id="back-btn" hidden data-requires-js>
    <ArrowLeftSvg />
    Back
  </button>

  <div class="spacer"></div>

  <button id="theme-btn" hidden>
    <SunSvg />
    <MoonSvg />
    Theme
  </button>

  <button id="print-btn" hidden data-requires-js>
    <PrinterSvg />
    Print
  </button>
</div>

<script>
  import { getBrowserTheme, getUserTheme, toggleTheme, getSessionStorageTheme, setUserTheme } from "@/utils/theme-utils";
  import { showElementsRequiringJs } from "@/utils/ui-utils";

  window.addEventListener("load", () => {
    showElementsRequiringJs();

    const backButton = document.querySelector(".secondary-buttons-row #back-btn");
    backButton?.addEventListener("click", () => history.back());

    const printButton = document.querySelector(".secondary-buttons-row #print-btn");
    printButton?.addEventListener("click", () => print());

    const sessionStorageTheme = getSessionStorageTheme();
    if (sessionStorageTheme) {
      setUserTheme(sessionStorageTheme);
    }

    const themeButton = document.querySelector(".secondary-buttons-row #theme-btn");
    themeButton?.addEventListener("click", () => {
      const newTheme = toggleTheme(getUserTheme() ?? getBrowserTheme());
      setUserTheme(newTheme);
    });
  });

  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
    const newBrowserTheme = e.matches ? "dark" : "light";
    setUserTheme(newBrowserTheme);
  });
</script>

