---
import ArrowLeftSvg from "@/icons/arrow-left.svg";
import PrinterSvg from "@/icons/printer.svg";
---
<style lang="scss">
	@use "resets";
	@use "breakpoints";

	#secondary-buttons-row {
		display: flex;
		flex-flow: row nowrap;
		column-gap: 1rem;
		padding: 1rem;

		> div#spacer {
			flex: 1;
		}

		> button {
			@include resets.button;
		}

		> a {
			@include resets.link;
		}
		
		> a, > button {
			font-size: 1rem; 
			line-height: 1;
			padding: .75rem 1.25rem;
			border-radius: 2rem;
			transition: background-color 0.5s, color 0.5s, transform 0.5s;
			cursor: pointer;
			color: var(--secondary-button-text-colour, #4e4e4e);
			
			&:hover {
				background-color: rgba(0,0,0, 0.15);
				color: var(--secondary-button-hover-text-colour, #000);
				transform: scale(1.05);
			}
		}

		#print-btn {
			display: none;

			&.visible {
				display: block;
			}
		}

		svg {
			height: 1rem;
			width: 1rem;
			position: relative;
			top: 2px;
		}
	}


	@media only screen and (min-width: breakpoints.$A4) {
		#secondary-buttons-row {
			padding: 1cm calc(1cm + 1rem);
		}
	}
</style>

<div id="secondary-buttons-row">
	<a href="/">
		<ArrowLeftSvg />
		Go Back
	</a>

	<div id="spacer"></div>

	<button id="print-btn">
		<PrinterSvg />
		Print
	</button>
</div>

<script>
	const printButton = document.querySelector<HTMLButtonElement>("#print-btn");
	if (printButton) {
		printButton.classList.add("visible");
		printButton.addEventListener("click", () => window.print());
	}
</script>

