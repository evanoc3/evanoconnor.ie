---
import ArrowLeftSvg from "@/icons/arrow-left.svg";
import PrinterSvg from "@/icons/printer.svg";
---
<style lang="scss">
	@use "resets";

	#secondary-buttons-row {
		display: flex;
		flex-flow: row nowrap;
		column-gap: 1rem;
		padding: 1cm;

		> div#spacer {
			flex: 1;
		}

		> button {
			@include resets.button;
		}

		> a {
			@include resets.link;
		}
		
		> a, > button {
			font-size: 1rem; 
			line-height: 1;
			padding: 1rem 1.5rem;
			border-radius: 2rem;
			transition: background-color 0.5s;
			cursor: pointer;
			
			&:hover {
				background-color: rgba(0,0,0, 0.2);
			}
		}

		svg {
			height: 1rem;
			width: 1rem;
			position: relative;
			top: 2px;
		}
	}
</style>

<div id="secondary-buttons-row">
	<a href="/index.html">
		<ArrowLeftSvg />
		Go Back
	</a>

	<div id="spacer"></div>

	<button id="print-btn">
		<PrinterSvg />
		Print
	</button>
</div>

<script>
	const printButton = document.querySelector("#print-btn");
	if (printButton) {
		printButton.addEventListener("click", () => window.print());
	}
</script>
