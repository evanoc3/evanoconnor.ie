<style lang="scss">
  div#go-sidebar {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr auto;
    padding: 1rem;
    background-color: #f6f6f6;
  }

  div#next-player-label {
    grid-area: 1 / 1 / 2 / 2;
  }

  div#buttons-row {
    grid-area: 3 / 1 / 4 / 2;
    display: flex;
    flex-flow: row nowrap;
    column-gap: 1rem;
    
    & > button {
      flex: 1;
      width: 50%;
      padding: 1rem;
      cursor: pointer;
    }
  }
</style>


<div id="go-sidebar" hidden data-requires-js>
  <div id="next-player-label">
    Next turn: <span id="next-player-value"></span>
  </div>

  <div id="buttons-row">
    <button id="new-game-btn">New game</button>
    <button id="forfeit-btn" disabled>Forfeit</button>
  </div>
</div>


<script>
  import { dispatchCustomEvent } from "@/utils/dom-utils.ts";
  window.addEventListener("load", onLoad);

  function onLoad(): void {
    const newGameButton = document.querySelector<HTMLButtonElement>("button#new-game-btn")!;
    const forfeitButton = document.querySelector<HTMLButtonElement>("button#forfeit-btn")!;

    newGameButton.addEventListener("click", () => dispatchCustomEvent(newGameButton, "new-game-btn-click"));
    forfeitButton.addEventListener("click", () => dispatchCustomEvent(forfeitButton, "forfeit-btn-click"));
  }
</script>
