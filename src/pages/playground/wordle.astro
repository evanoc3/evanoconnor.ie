---
import GoBack from "@/components/common/go-back.astro";
import NoScriptMessage from "@/components/common/no-script-message.astro";
import PageLayout from "@/components/common/page-layout.astro";
import { WordleApp } from "@/components/wordle/index.ts";
---


<style lang="scss">
  @use "mixins";

  @include mixins.global-style(".go-back", $isAstroStyle: true) {
    position: fixed;
    top: 6.5px;
    left: 6.5px;
    color: var(--header-button-icon-colour, white) !important;
  }
</style>

<PageLayout
  title="Wordle app showcase"
  description="Demonstration of a Wordle clone built with React."
  keywords={["Wordle", "custom component", "React", "TypeScript"]}
>
  <GoBack />

  <NoScriptMessage />

  <WordleApp client:only="react" />
</PageLayout>
