---
import GoBack from "@/components/common/GoBack.astro";
import NoScriptMessage from "@/components/common/NoScriptMessage.astro";
import PageLayout from "@/components/common/PageLayout.astro";
import { WordleApp } from "@/wordle/index.ts";
---

<style lang="scss">
  @use "mixins";

  @include mixins.global-style(".go-back", $isAstroStyle: true) {
    position: fixed;
    top: 1rem;
    left: 1rem;
  }
</style>

<PageLayout
  title="Wordle app showcase"
  description="Demonstration of a Wordle clone built with React."
  keywords={["Wordle", "custom component", "React", "TypeScript"]}
>
  <GoBack />

  <NoScriptMessage />

  <WordleApp client:only="react" />
</PageLayout>
