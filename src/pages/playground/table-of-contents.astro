---
import PageLayout from "@/components/common/PageLayout.astro";
import GoBack from "@/components/common/GoBack.astro";
import TableOfContentsElement from "@/components/playground/table-of-contents/TableOfContents.ts";
---

<style lang="scss">
  @use "page";
  @use "resets";
  @use "theme";

  @include page.full-height;
  @include resets.global;
  @include resets.fonts;

  @include theme.set-vars(
    $light-theme-colours: (
      --background-colour: white,
      --text-colour: #222,
      --link-colour: LinkText,
      --link-visited-colour: VisitedText,
      --link-active-colour: ActiveText
    ),
    $dark-theme-colours: (
      --background-colour: #181818,
      --text-colour: #eee,
      --link-colour: #0ff,
      --link-visited-colour: #099,
      --link-active-colour: #0ff
    )
  );

  :global(body) {
    background-color: var(--background-colour);
    color: var(--text-colour);
  }

  :global(.go-back) {
    position: fixed;
    top: 1rem;
    left: 1rem;
  }

  div#page-container {
    display: grid;
    grid-template-rows: auto;
    grid-template-columns: 1fr 85ch 1fr;
    gap: 1rem;
    min-height: 100vh;
    width: 100vw;
    padding: 10rem 0 5rem;
  }

  div#left-col {
    grid-row: 1 / 2;
    grid-column: 1 / 2;
    display: flex;
    flex-flow: row nowrap;
    justify-content: flex-end;
    align-items: flex-start;

    eoc-toc {
      margin-inline-end: 3rem;
      position: sticky;
      top: 10rem;
    }
  }

  main {
    grid-row: 1 / 2;
    grid-column: 2 / 3;
    overflow: visible;
    font-size: 1.2rem;

    hr {
      margin: 5rem 0;
    }

    :global(h1, h2, h3, h4, h5, h6) {
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
      line-height: 1;
    }

    :global(p) {
      margin-bottom: 0.5rem;
    }
  }
</style>

<PageLayout
  title="Table of Contents component showcase"
  description="Demonstration of a Table of Contents component built with Lit."
  keywords={["custom component", "Lit", "TypeScript"]}
>
  <GoBack />

  <div id="page-container">
    <div id="left-col">
      <TableOfContentsElement
        client:only
        target-id="main"
        table-title="Table of Contents"
      ></TableOfContentsElement>
    </div>

    <main id="main">
      <p hidden data-requires-js>
        This experiment is to demonstrate the 'Table of Contents' component on the left. It is
        a self-contained web-component which takes a HTML element's ID as its target-id attribute
        value, generates a representation of the hierarchy of headings within that target element,
        and displays it as a nested list. Where possible the component will also detect headings
        which have IDs, and make the entries in the table corresponding to that heading into a link.
      </p>

      <p hidden data-requires-js>
        The rest of the text content on this page is dynamically generated gibberish, with a number
        of headings and paragaphs to give you a better a sense of how the component works.
      </p>

      <noscript>
        <p>
          Javascript is required to be enabled for this component to work. Please enable Javascript and
          reload the page to view this demonstration.
        </p>
      </noscript>

      <hr />

      {/* More paragraphs will be dyanmically generated and added here by JS at runtime */}
    </main>
  </div>

  <script>
    import { randInt, generateGibberish } from "@/utils/rand-utils";

    window.addEventListener("load", () => {
      const main = document.querySelector("main")!;
      for(let i = 0; i < 20; i++) {
        const heading = generateRandomHeading();
        main.appendChild(heading);

        const parasCount = randInt(1, 3);
        for(let j = 0; j < parasCount; j++) {
          const para = generateDummyParagraph();
          main.appendChild(para);
        }
      }
    });

    function generateRandomHeading(): HTMLHeadingElement {
      const level = randInt(1, 6);
      const heading = document.createElement(`h${level}`) as HTMLHeadingElement;

      const chanceHeadingHasId = 0.5;
      if(Math.random() < chanceHeadingHasId) {
        heading.id = generateGibberish();
      }
      
      heading.textContent = `This is a level ${level} header`;
      return heading;
    }

    const loremIpsumPara = `
      Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
      Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
      Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.
      Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
    `;

    function generateDummyParagraph(): HTMLParagraphElement {
      const para = document.createElement("p");
      para.textContent = loremIpsumPara;
      return para;
    }
  </script>
</PageLayout>
