---
import PageLayout from "@/components/common/PageLayout.astro";
import GoBack from "@/components/common/GoBack.astro";
import GoSidebar from "@/components/playground/go/GoSidebar.astro";
import GoBoard from "@/components/playground/go/GoBoard.ts";
---


<style lang="scss">
  @use "resets";

  @include resets.global;
  @include resets.fonts;

  div#page-layout {
    width: 100%;
    height: 100vh;
    display: grid;
    grid-template-columns: 1fr 25vw;
    grid-template-rows: auto 1fr;
  }

  .go-back {
    grid-area: 1 / 1 / 2 / 2;
  }

  div#play-area {
    grid-area: 2 / 1 / 3 / 2;
    padding: 2rem;
    display: grid;
    place-items: center;

    eoc-goboard {
      width: 100%;
      height: 100%;
    }
  }

  :global(div#go-sidebar) {
    grid-area: 1 / 2 / 3 / 2;
  }
</style>


<PageLayout
  title="Interactive go game showcase"
  description="Demonstration of an interactive Go board component"
>
  <div id="page-layout" class="no-js">
    <GoBack />

    <div id="play-area">
      <GoBoard client:only />

      <noscript>
        <p>
          This playground contains an interactive component which requires JavaScript to be enabled in order to function.
          Please enable JavaScript in your browser and reload to view this playground.
        </p>
      </noscript>
    </div>

    <GoSidebar />
  </div>

  <script>
    import type { GoBoardElement } from "@/components/playground/go/GoBoard.ts";
    import type { GoPosition } from "@/components/playground/go/Go.types.ts";
    import { GoGameService } from "@/components/playground/go/GoGameService.ts";

    const goGameService = new GoGameService();

    window.addEventListener("load", startNewGame);

    function startNewGame(): void {
      const goBoardElement = document.querySelector<GoBoardElement>("eoc-goboard")!;
      const nextPlayerLabel = document.querySelector<HTMLSpanElement>("span#next-player-value")!;
      const forfeitButton = document.querySelector<HTMLButtonElement>("button#forfeit-btn")!;

      const game = goGameService.newGame();

      function update(): void {
        goBoardElement.setAttribute("data-stones", JSON.stringify(game.stones));

        (game.state === "inProgress")
          ? goBoardElement.setAttribute("data-editable", "")
          : goBoardElement.removeAttribute("data-editable");

        nextPlayerLabel.textContent = game.nextTurnColour;
        forfeitButton.disabled = game.state === "ended";
      }

      function cleanup(): void {
        document.removeEventListener("new-game-btn-click", newGameBtnClickHandler);
        document.removeEventListener("forfeit-btn-click", forfeitBtnClickHandler);
        game.removeEventListener("new-turn-made", newTurnMadeHandler);
        game.removeEventListener("game-state-changed", gameStateChangedHandler);
        goBoardElement.removeEventListener("stone-placed", stonePlacedHandler);
      }

      const newGameBtnClickHandler = () => { cleanup(); startNewGame(); };
      const forfeitBtnClickHandler = () => game.end();
      const newTurnMadeHandler = () => update();
      const gameStateChangedHandler = () => update();
      const stonePlacedHandler = (e: CustomEvent<{ position: GoPosition }>) => game.newTurn({ ...e.detail.position, colour: game.nextTurnColour });

      document.addEventListener("new-game-btn-click", newGameBtnClickHandler);
      document.addEventListener("forfeit-btn-click", forfeitBtnClickHandler);
      game.addEventListener("new-turn-made", newTurnMadeHandler);
      game.addEventListener("game-state-changed", gameStateChangedHandler);
      goBoardElement.addEventListener("stone-placed", stonePlacedHandler);

      update();
    }

  </script>
</PageLayout>
