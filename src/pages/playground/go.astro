---
import PageLayout from "@/components/common/PageLayout.astro";
import GoBoard from "@/components/playground/go/GoBoard.ts";
import GoBack from "@/components/common/GoBack.astro";
---


<style lang="scss">
  @use "resets";

  @include resets.global;

  eoc-goboard {
    width: 80vw;
    height: 80vh;
  }
</style>


<PageLayout
  title="Go Game | evanoconnor.ie"
  description=""
>
  <GoBack />

  <noscript>
  </noscript>

  <div>
    <GoBoard client:only />
    <div>Next player: <span id="next-player-label"></span></div>
  </div>

  <script>
    import type { GoBoardElement } from "@/components/playground/go/GoBoard.ts";
import type { GoGame } from "@/components/playground/go/GoGame.ts";
    import { GoGameService } from "@/components/playground/go/GoGameService.ts";

    window.addEventListener("load", setupGoPlayground);

    function setupGoPlayground(): void {
      const goBoardElement = document.querySelector<GoBoardElement>("eoc-goboard");
      const nextPlayerLabel = document.querySelector<HTMLSpanElement>("span#next-player-label");
      if(!goBoardElement || !nextPlayerLabel) {
        return;
      }

      const goGameService = new GoGameService();
      const goGame = goGameService.newGame();

      goBoardElement.addEventListener("stone-placed", (e) => {
        goGame.newTurn({
          ...e.detail.position,
          colour: goGame.nextTurnColour
        });
      });

      goGame.addEventListener("new-turn-made", () => {
        updateBoard(goGame, goBoardElement, nextPlayerLabel);
      });

      updateBoard(goGame, goBoardElement, nextPlayerLabel);
    }

    function updateBoard(goGame: GoGame, goBoardElement: GoBoardElement, nextPlayerLabel: HTMLSpanElement): void {
      nextPlayerLabel.textContent = goGame.nextTurnColour;
      goBoardElement.setAttribute("data-stones", JSON.stringify(goGame.stones));
      goBoardElement.setAttribute("data-editable", "");

    }
  </script>

</PageLayout>
