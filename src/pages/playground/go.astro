---
import PageLayout from "@/components/common/PageLayout.astro";
import GoBack from "@/components/common/GoBack.astro";
import NoScriptMessage from "@/components/common/NoScriptMessage.astro";
import GoPlayground from "@/components/playground/go/GoPlayground.tsx";
---


<style lang="scss">
  @use "resets";

  @include resets.global;
  @include resets.fonts;

  div#page-layout {
    width: 100%;
    height: 100vh;
  }

  :global(.go-back) {
    position: absolute;
    top: 1rem;
    left: 1rem;
  }

  p#no-script-msg {
    display: inline-block;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(75vw, 80ch);
    text-align: center;
  }
</style>


<PageLayout
  title="Interactive go game showcase"
  description="Demonstration of an interactive Go board component"
>
  <div id="page-layout">
    <GoBack />

    <NoScriptMessage  />

    <GoPlayground client:only="react" />
  </div>
</PageLayout>
