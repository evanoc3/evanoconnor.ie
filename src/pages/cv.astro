---
import PageLayout from "@/components/PageLayout.astro";
import SecondaryButtonsRow from "@/components/cv/SecondaryButtonsRow.astro";
import HeroCell from "@/components/cv/HeroCell.astro";
---

<style lang="scss">
	@use "resets";
	@use "page";
	
	@include resets.global;
	@include page.optimize-for-text;

	:global(body) {
		background-color: #ddd;
	}

	main {
		width: 210mm;
		height: 297mm;
		margin: 0 auto 1in;
		padding: 1.5cm;
		background-color: white;
	}

	#secondary-buttons-row-container {
		display: none;

		&.visible {
			display: block;
		}
	}
	
  
	@media only print {
		@page {
			size: A4;
			margin: 1.5cm;
		}

		:global(body) {
			background-color: unset;
		}

		#secondary-buttons-row-container.visible {
			display: none;
		}
	}
</style>

<PageLayout title="CV | evanoconnor.ie">
	<div id="secondary-buttons-row-container">
		<SecondaryButtonsRow />
	</div>

	<main>
		<HeroCell />
	</main>
</PageLayout>


<script>
	const secondaryButtonsRowContainer = document.querySelector<HTMLDivElement>("#secondary-buttons-row-container");
	if(secondaryButtonsRowContainer) {
		secondaryButtonsRowContainer.classList.add("visible");
	}
</script>
