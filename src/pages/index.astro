---
import PageLayout from "@/components/PageLayout.astro";
---

<style lang="scss">
  @use "page";
  @use "resets";

  @include page.full-height;
  @include page.optimize-for-text;
  @include resets.global;

  main {
    font-size: 1.15rem;
    line-height: 1.4;
    margin: 25vh auto 0;
    padding: 1rem;
    width: min(75ch, 100vw);
  }

  ul {
    font-family: monospace;
    list-style: none;
  }
</style>

<PageLayout title="evanoconnor.ie">
  <main>
    <p>
      Hi there!
      <br />
      I'm Evan O'Connor.
      <br />
      A software engineer at Cisco in Galway, Ireland.
    </p>

    <br />

    <p>
      You'll have to forgive the mess.
      <br />
      I'm still cleaning the place up,
      <br />
      but feel free to have a look around!
    </p>

    <br />
    
    <ul>
      <li><a href="/cv">/cv</a></li>
      <li><a href="/experiments/lightspeed">/experiments/lightspeed</a></li>
    </ul>
  </main>
</PageLayout>
