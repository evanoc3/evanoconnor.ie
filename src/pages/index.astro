---
import PageLayout from "@/components/PageLayout.astro";
---

<style lang="scss">
  @use "page";
  @use "resets";

  @include page.full-height;
  @include page.optimize-for-text;
  @include resets.global;

  :global(body) {
    --background-colour: white;
    --text-colour: #222;
  }

  @media(prefers-color-scheme: dark) {
    :global(body) {
      --background-colour: #222;
      --text-colour: #eee;
      --link-colour: #0ff;
    }
  }

  :global(body) {
    background-color: var(--background-colour);
  }

  main {
    font-size: 1.15rem;
    line-height: 1.4;
    margin: 25vh auto 0;
    padding: 1rem;
    width: min(75ch, 100vw);
    color: var(--text-colour);
  }

  ul {
    font-family: monospace;
    list-style: none;
  }

  a {
    color: var(--link-colour, revert);
  }
</style>

<PageLayout
  title="evanoconnor.ie"
  description="Evan O'Connor's personal website"
>
  <main>
    <p>
      Hi there!
      <br />
      I'm Evan O'Connor.
      <br />
      A software engineer at Cisco in Galway, Ireland.
    </p>

    <br />

    <p>
      You'll have to forgive the mess.
      <br />
      I'm still cleaning the place up,
      <br />
      but feel free to have a look around!
    </p>

    <br />
    
    <ul>
      <li><a href="/cv">/cv</a></li>
      <li><a href="/experiments/lightspeed">/experiments/lightspeed</a></li>
    </ul>
  </main>
</PageLayout>
