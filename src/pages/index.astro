---
import PageLayout from "@/components/common/PageLayout.astro";
import Footer from "@/components/index/Footer.astro";
---

<style lang="scss">
  @use "page";
  @use "resets";
  @use "theme";

  @include page.full-height;
  @include page.optimize-for-text;
  @include resets.global;

  @include theme.set-vars(
    $light-theme-colours: (
      --background-colour: white,
      --text-colour: #222,
      --link-colour: LinkText,
      --link-visited-colour: VisitedText,
      --link-active-colour: ActiveText
    ),
    $dark-theme-colours: (
      --background-colour: #181818,
      --text-colour: #eee,
      --link-colour: #0ff,
      --link-visited-colour: #099,
      --link-active-colour: #0ff
    )
  );

  :global(body) {
    background-color: var(--background-colour);
  }

  main {
    font-size: 1.15rem;
    line-height: 1.4;
    padding: 25vh 1rem 0;
    margin: 0 auto;
    width: min(75ch, 100vw);
    color: var(--text-colour);
    min-height: 100vh;
  }

  ul {
    font-family: monospace;
    list-style: none;
  }

  a {
    color: var(--link-colour);

    &:visited {
      color: var(--link-visited-colour);
    }

    &:active {
      color: var(--link-active-colour);
    }
  }
</style>

<PageLayout
  title="Homepage"
  description="Homepage of Evan O'Connor's personal website"
>
  <main>
    <p>
      Hi there!
      <br />
      I'm Evan O'Connor.
      <br />
      A software engineer at Cisco in Galway, Ireland.
    </p>

    <br />

    <p>
      You'll have to forgive the mess.
      <br />
      I'm still cleaning the place up,
      <br />
      but feel free to have a look around!
    </p>

    <br />
    
    <ul>
      <li><a href="/cv/">/cv</a></li>
      <li><a href="/playground/go/">/playground/go</a></li>
      <li><a href="/playground/lightspeed/">/playground/lightspeed</a></li>
      <li><a href="/playground/table-of-contents/">/playground/table-of-contents</a></li>
      <!-- <li><a href="/playground/wordle/">/playground/wordle</a></li> -->
    </ul>
  </main>

  <Footer />
</PageLayout>
